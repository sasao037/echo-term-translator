{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "echo-term-translator",
  "compatibility_date": "2026-07-28",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "DATA_KV",
      // Replace after running: npx wrangler kv namespace create DATA_KV
      "id": "REPLACE_WITH_KV_NAMESPACE_ID"
    }
  ]
}
